# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD='sunbo.0208'
DB_NAME=chat_app

# ===== DashScope (阿里云百炼) =====
# 兼容 OpenAI 协议：https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 文本模型（用户原话为 qwen3.8-max，DashScope 实际可用：qwen-max / qwen-max-latest / qwen3-max 等）
LLM_TEXT_MODEL=qwen-max
# 多模态模型（含图片输入）
LLM_VL_MODEL=qwen-vl-max-latest

# ===== 服务 =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 文件上传目录与访问前缀
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/uploads
# 允许跨域的前端来源（开发环境）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
