{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://39.96.63.42/review/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://39.96.63.42/review/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
