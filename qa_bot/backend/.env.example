# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD='your_password'
DB_NAME=qa_bot

# ===== DashScope（Embedding + LLM）=====
# 阿里云百炼 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v1

# ===== LLM 生成参数 =====
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ===== RAG 文档与向量库 =====
DOC_PATH=./data/银行个金客户经理考核办法.docx
CHROMA_PERSIST_DIR=./chroma_db_qa
CHROMA_COLLECTION=qa_collection
RAG_TOP_K=2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== 服务 =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
